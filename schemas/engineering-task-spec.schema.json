{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0718lol/verify-engineering-work/schemas/engineering-task-spec.schema.json",
  "title": "Engineering Task Specification",
  "type": "object",
  "required": ["version", "tasks"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "category",
        "prompt",
        "template",
        "verification",
        "calibration"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "category": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 1},
        "verification": {
          "type": "object",
          "required": ["public_command", "hidden_test"],
          "additionalProperties": false,
          "properties": {
            "public_command": {"$ref": "#/$defs/command"},
            "hidden_test": {"type": "string", "minLength": 1}
          }
        },
        "calibration": {
          "type": "object",
          "required": ["public_passes", "held_out_passes"],
          "additionalProperties": false,
          "properties": {
            "public_passes": {"type": "boolean"},
            "held_out_passes": {"type": "boolean"}
          }
        }
      }
    }
  }
}
