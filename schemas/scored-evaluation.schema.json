{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/0718lol/verify-engineering-work/schemas/scored-evaluation.schema.json",
  "title": "Scored Paired Engineering Evaluation",
  "type": "object",
  "required": ["experiment", "cases"],
  "properties": {
    "experiment": {
      "type": "object",
      "required": [
        "skill_version",
        "rubric_version",
        "model",
        "harness",
        "task_set_version",
        "token_budget",
        "skill_commit",
        "task_set_sha256",
        "runner_schema_version",
        "skill_body_sha256",
        "preparation_manifest_sha256",
        "codex_home_manifest_sha256",
        "held_out_isolation"
      ],
      "properties": {
        "skill_version": {"type": "string", "minLength": 1},
        "rubric_version": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1},
        "task_set_version": {"type": "string", "minLength": 1},
        "token_budget": {"type": "number", "exclusiveMinimum": 0},
        "skill_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "task_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "runner_schema_version": {"type": "string", "minLength": 1},
        "skill_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preparation_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "codex_home_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "held_out_isolation": {"const": "evaluator-external"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "variant",
          "scores",
          "critical_failures",
          "machine_verification_passed",
          "public_verification_passed",
          "held_out_verification_passed",
          "token_budget_exceeded"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "variant": {"enum": ["baseline", "skill"]},
          "scores": {"type": "object"},
          "critical_failures": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "machine_verification_passed": {"type": ["boolean", "null"]},
          "public_verification_passed": {"type": ["boolean", "null"]},
          "held_out_verification_passed": {"type": ["boolean", "null"]},
          "token_budget_exceeded": {"type": ["boolean", "null"]}
        }
      }
    }
  }
}
